#!/usr/bin/env bash
# {{ ansible_managed }}
# Restart wg-pia container if the WireGuard handshake is stale.

set -o errexit
set -o pipefail
set -o nounset
# set -o xtrace

INTERFACE="{{ wg_pia_interface }}"
MAX_HANDSHAKE_AGE="{{ wg_pia_handshake_timeout }}"
CONTAINER_NAME="{{ wg_pia_container_name }}"

log_info()    { echo "$1" | systemd-cat -t check_wg_pia -p info; }
log_warning() { echo "$1" | systemd-cat -t check_wg_pia -p warning; }

HANDSHAKE_TS=$(/usr/local/bin/wg-json | jq -r ".$INTERFACE.peers | to_entries[0].value.latestHandshake // empty")

if [ -z "$HANDSHAKE_TS" ]; then
  log_warning "no handshake recorded on $INTERFACE, restarting $CONTAINER_NAME"
  docker restart "$CONTAINER_NAME"
  exit 0
fi

NOW=$(date +%s)
AGE=$(( NOW - HANDSHAKE_TS ))

if [ "$AGE" -gt "$MAX_HANDSHAKE_AGE" ]; then
  log_warning "last handshake on $INTERFACE was ${AGE}s ago (threshold: ${MAX_HANDSHAKE_AGE}s), restarting $CONTAINER_NAME"
  docker restart "$CONTAINER_NAME"
else
  log_info "$INTERFACE healthy, last handshake ${AGE}s ago"
fi
